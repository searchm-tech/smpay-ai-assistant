# sql/apply_migrations.py 와 DB 테스트가 읽는 설정. 이 파일을 .env 로 복사해 값을 채운다 (.env 는 git 제외).
# 실제 값은 채팅·이슈·커밋에 붙이지 않는다.

# 마이그레이션 적용용 관리자 연결. Supabase 풀러의 "세션 모드"(포트 5432) 연결 문자열.
# 풀러 사용자명은 postgres.<프로젝트ref> 형식이며, 역할별 연결은 여기서 사용자·비밀번호만 바꿔 자동으로 만든다.
DATABASE_ADMIN_URL=

# 앱 역할 비밀번호: 24자 이상 ASCII 임의 문자열. 예) python -c "import secrets;print(secrets.token_urlsafe(32))"
# apply_migrations.py 가 SCRAM 검증값으로 DB에 설정한다. chat 서버 / 수집 배치가 각각 이 역할로 접속한다.
CHAT_READER_PASSWORD=
INGEST_WRITER_PASSWORD=

# --- ingest/ (Notion 수집, 회사 데스크탑에서 실행) ---
# Notion 내부 통합(Internal integration)의 토큰. 권한은 "Read content"만 선택한다(수정·댓글·사용자 정보 권한 없음).
NOTION_TOKEN=
# 수집할 루트 페이지 목록(허용 목록). 페이지 ID 또는 URL을 쉼표/공백/줄바꿈으로 구분. 비어 있으면 시작하지 않는다.
# 각 루트 페이지에서 ••• → Connections 로 위 통합을 연결해야 한다(통합은 공유된 페이지만 볼 수 있다).
NOTION_ROOT_PAGE_IDS=
# 선택: 초당 호출 수(기본 2.5, Notion은 연결당 분당 180회) / 최대 수집 페이지 수(기본 5000)
# NOTION_RATE_PER_SEC=2.5
# NOTION_MAX_PAGES=5000

# --- ingest/ 동기화 (python -m notion_ingest sync) ---
# 임베딩 서버(embedder, smpay-kure-model 컨테이너)와 같은 값. 32자 이상. 서버 주소 기본값은 http://127.0.0.1:8001
EMBEDDER_SECRET=
# EMBEDDER_URL=http://127.0.0.1:8001
# 수집 배치가 접속할 ingest_writer 연결 문자열(회사 데스크탑 운영용). 관리자 URL 대신 이것만 둔다.
# Supabase 풀러는 "세션 모드"(포트 5432)여야 한다(동시 실행 방지 잠금이 세션 단위). 사용자명은 ingest_writer.<프로젝트ref>
# 비워 두면 개발 편의상 위의 DATABASE_ADMIN_URL 호스트 + INGEST_WRITER_PASSWORD 로 자동 구성한다.
INGEST_DATABASE_URL=
# 선택: 고위험 민감정보 패턴(주민번호·카드번호·API 키 모양·"비밀번호:" 대입)이 보여도 사람이 확인하고 색인을 허용할 문서 ID
# (기본은 이런 문서를 색인하지 않고 리포트에만 올린다). 쉼표/공백/줄바꿈 구분
# INGEST_ALLOW_SENSITIVE_PAGE_IDS=
